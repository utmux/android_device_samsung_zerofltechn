     void            *err_cb_data;   // error callback data
     uint8_t b_del_handler;
+    void            *client_data;   // opaque caller-owned context
 } RilClientPrv;
 
 
@@ -317,6 +318,41 @@ int RegisterErrorCallback(HRilClient client, RilOnError cb, void *data) {
 }
 
 
+/**
+ * Store an opaque caller-owned context pointer on a client handle.
+ *
+ * Samsung's ERK2 at_distributor uses this private extension to associate its
+ * callback with each RIL client.  The stock implementation ignores len and
+ * returns 1 on success, so preserve that ABI exactly.
+ */
+extern "C"
+int SetClientData(HRilClient client, void *data, size_t len) {
+    (void)len;
+
+    if (client == NULL || client->prv == NULL) {
+        RLOGE("%s: Invalid client %p", __FUNCTION__, client);
+        return RIL_CLIENT_ERR_INVAL;
+    }
+
+    ((RilClientPrv *)(client->prv))->client_data = data;
+    return 1;
+}
+
+
+/**
+ * Retrieve the opaque context installed by SetClientData().
+ */
+extern "C"
+void *GetClientData(HRilClient client) {
+    if (client == NULL || client->prv == NULL) {
+        RLOGE("%s: Invalid client %p", __FUNCTION__, client);
+        return NULL;
+    }
+
+    return ((RilClientPrv *)(client->prv))->client_data;
+}
+
+
