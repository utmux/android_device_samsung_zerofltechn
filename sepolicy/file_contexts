# QMUX socket areas.
/dev/socket/qmux_audio(/.*)?           u:object_r:qmuxd_socket:s0
/dev/socket/qmux_bluetooth(/.*)?       u:object_r:qmuxd_socket:s0
/dev/socket/qmux_gps(/.*)?             u:object_r:qmuxd_socket:s0
/dev/socket/qmux_radio(/.*)?           u:object_r:qmuxd_socket:s0

# Qualcomm external modem devices.
/dev/subsys_.*                         u:object_r:ssr_device:s0
/dev/diag                              u:object_r:diag_device:s0
/dev/esoc.*                            u:object_r:esoc_device:s0
/dev/bhi                               u:object_r:bhi_device:s0
/dev/mhi_pipe_.*                       u:object_r:mhi_device:s0
/dev/ks_hsic_bridge                    u:object_r:ksbridgehsic_device:s0
/dev/efs_hsic_bridge                   u:object_r:efsbridgehsic_device:s0
/dev/block/platform/.+/by-name/m9kefs([1-3]|c) u:object_r:efs_boot_dev:s0

# UART used by the ERK2 AT distributor.
/dev/ttySAC1                          u:object_r:atd_uart_device:s0

# G9200 NFC controller and embedded secure element.
/dev/pn547                            u:object_r:nfc_device:s0
/dev/p61                              u:object_r:nfc_device:s0
/data/vendor/nfc(/.*)?               u:object_r:vendor_nfc_data_file:s0

# Samsung Wi-Fi control and diagnostic flags.
/data/misc/conn(/.*)?                u:object_r:wifi_conn_data_file:s0
/dev/alarm                            u:object_r:legacy_alarm_device:s0
/dev/batch_io                         u:object_r:sensor_device:s0
/dev/vfsspi                           u:object_r:fingerprint_device:s0

# Android creates a compatibility schedtune tree on tmpfs on this kernel.
/dev/stune(/.*)?                      u:object_r:cgroup:s0

# ESOC is reached through /sys/bus/esoc by libmdmdetect.
/sys/bus/esoc(/.*)?                    u:object_r:sysfs_esoc:s0
/sys/devices/qcom,mdm1\.53/esoc0(/.*)? u:object_r:sysfs_esoc:s0

# Health and storage framework inputs.
/sys/devices/battery\.52/power_supply/battery/(present|current_now) u:object_r:sysfs_batteryinfo:s0
/sys/devices/15570000\.ufs/host0/target0:0:0/0:0:0:0/block/sda/stat u:object_r:sysfs_disk_stat:s0

# Sensor HAL control nodes.
/sys/devices/virtual/sensors/ssp_sensor/(enable|ssp_flush) u:object_r:sysfs_sensors:s0
/sys/devices/14d30000\.spi/spi_master/spi1/spi1\.0/iio:device[0-9]+/buffer/enable u:object_r:sysfs_sensors:s0

# The class entries are symlinks; label the physical input nodes as well.
/sys/devices/virtual/input/input[01]/enabled u:object_r:power_hal_sysfs:s0

# Qualcomm/Samsung radio daemons copied from ERK2.
/system/bin/ATFWD-daemon               u:object_r:atfwd_exec:s0
/system/bin/at_distributor             u:object_r:at_distributor_exec:s0
/system/bin/connfwexe                  u:object_r:connfwexe_exec:s0
/system/bin/ddexe                      u:object_r:ddexe_exec:s0
/system/bin/diag_uart_log              u:object_r:diag_exec:s0
/system/bin/irsc_util                  u:object_r:irsc_util_exec:s0
/system/bin/ks                         u:object_r:mdm_helper_exec:s0
/system/bin/mdm_helper                 u:object_r:mdm_helper_exec:s0
/system/bin/mdm_helper_proxy           u:object_r:mdm_helper_exec:s0
/system/bin/qmuxd                      u:object_r:qmuxd_exec:s0

