# Legacy proc nodes used by Samsung's irqbalance daemon.
genfscon proc /irq u:object_r:proc_irq_affinity:s0
genfscon proc /sys/vm/dirty_bytes u:object_r:proc_dirty:s0

# Health, power, touch, sensor and display nodes on the G9200 kernel.
genfscon sysfs /devices/battery.52/power_supply/battery/capacity u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/battery.52/power_supply/battery/voltage_now u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/battery.52/power_supply/battery/temp u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/battery.52/power_supply/battery/status u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/battery.52/power_supply/ac/type u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/battery.52/power_supply/ps u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/14ac0000.mali/dvfs_min_lock u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/14e10000.hsi2c/i2c-6/6-0049/input/input1/enabled u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/14e70000.hsi2c/i2c-2/2-0020/input/input0/enabled u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/14e10000.hsi2c/i2c-6/6-0049/input/input1 u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/14e70000.hsi2c/i2c-2/2-0020/input/input0 u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu0/cpufreq/scaling_governor u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu4/cpufreq/scaling_governor u:object_r:power_hal_sysfs:s0
genfscon sysfs /devices/14d30000.spi/spi_master/spi1/spi1.0 u:object_r:sysfs_sensors:s0
genfscon sysfs /devices/virtual/sensors u:object_r:sysfs_sensors:s0
genfscon sysfs /devices/virtual/sec/tsp/cmd_list u:object_r:sysfs_touchscreen:s0
genfscon sysfs /devices/virtual/sec/tsp/cmd u:object_r:sysfs_touchscreen:s0
genfscon sysfs /devices/virtual/sensors/irled_remote/irled_send u:object_r:sysfs_ir_remote:s0
genfscon sysfs /devices/virtual/sec/sec_key/wakeup_keys u:object_r:sysfs_key_wakeup:s0
genfscon sysfs /devices/virtual/sensors/ssp_sensor/mag_poll_delay u:object_r:sysfs_sensors:s0
genfscon sysfs /devices/virtual/sensors/ssp_sensor/sig_motion_poll_delay u:object_r:sysfs_sensors:s0
genfscon sysfs /devices/13930000.decon_fb/psr_info u:object_r:sysfs_vsync:s0
genfscon sysfs /power/ipa/control_temp u:object_r:power_hal_sysfs:s0
genfscon sysfs /power/ipa/enabled u:object_r:power_hal_sysfs:s0

# Camera firmware controls are sysfs nodes, not /dev camera devices.
genfscon sysfs /devices/virtual/camera u:object_r:sysfs_camera_writable:s0

# Narrow labels for the memory accounting files read by system_server.
genfscon debugfs /mali/mem    u:object_r:debugfs_mali_mem:s0
genfscon debugfs /ion/clients u:object_r:debugfs_ion_clients:s0

# Charging control nodes written by init from persistent Settings properties.
genfscon sysfs /devices/battery.52/power_supply/battery/charge_control_enabled u:object_r:sysfs_charging_control:s0
genfscon sysfs /devices/battery.52/power_supply/battery/charge_control_start_threshold u:object_r:sysfs_charging_control:s0
genfscon sysfs /devices/battery.52/power_supply/battery/charge_control_end_threshold u:object_r:sysfs_charging_control:s0
genfscon sysfs /devices/battery.52/power_supply/battery/bypass_charging u:object_r:sysfs_charging_control:s0
